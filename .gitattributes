# Store text with LF in the repo and check it out with LF on every OS.
# Without this, Windows tools can turn mvnw into CRLF and Linux then fails with
# "/bin/sh^M: bad interpreter".
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch
*.jar binary
*.png binary
*.zip binary
